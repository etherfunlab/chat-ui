# --- Required in every deployment ---

# Postgres connection string (any provider; Neon works out of the box).
# On serverless, use your provider's pooled connection string (Neon: -pooler).
DATABASE_URL=postgres://user:password@host:5432/chatui

# Secret for the session cookie. At least 32 random characters — anyone who
# knows it can forge a session for any wallet. Generate one:
#   openssl rand -base64 48
SESSION_SECRET=

# Upstream Venice API key. Never exposed to the browser.
VENICE_API_KEY=

# The app's public URL, used as the wallet-signing domain and the same-origin
# reference. Required in production unless deployed on Vercel (which controls
# Host / X-Forwarded-* itself); elsewhere those headers are attacker-controlled.
# Example: https://chat.example.com
PUBLIC_ORIGIN=

# --- Deployment mode ---

# "on": public billing deployment — anyone can sign in, usage is charged.
# "off": private deployment — only ALLOWED_WALLETS can sign in, nothing is charged.
BILLING=on

# Comma-separated wallet addresses allowed to sign in. Required when BILLING=off.
ALLOWED_WALLETS=

# --- Required when BILLING=on ---

# Solana mainnet RPC endpoint used for payment verification.
SOLANA_RPC_URL=

# USDC treasury address that receives top-ups.
SOLANA_TREASURY=

# Markup applied on top of upstream cost, as a decimal. 0.10 = +10%.
PRICE_MARKUP=0

# Comma-separated wallets exempt from the markup (pay upstream cost as-is).
MARKUP_EXEMPT_WALLETS=

# Flat fee in USD charged per request that has web search enabled.
SEARCH_FEE_USD=0.01
